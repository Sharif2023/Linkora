generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  
  accounts      Account[]
  sessions      Session[]
  savedItems    SavedItem[]
  collections   Collection[]
  alerts        Alert[]
  reports       Report[]
  subscriptions Subscription[]
  ideaProgress  UserIdeaProgress[]
  taskProgress  UserTaskProgress[]
  
  curator       Curator?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Curator {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio         String?
  website     String?
  
  collections Collection[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Resource {
  id                 String   @id @default(cuid())
  url                String   @unique
  title              String
  description        String
  logo               String?
  
  categoryId         String?
  category           Category? @relation(fields: [categoryId], references: [id])
  
  tags               Tag[]    @relation("ResourceTags")
  
  pricingModel       String? // Free, Freemium, Paid
  freeTier           Boolean  @default(false)
  payoutMethods      String? // e.g., PayPal, Crypto, Wire
  minPayout          Float?
  supportedCountries String?
  fees               String?
  currency           String?
  
  verificationDate   DateTime?
  lastChecked        DateTime?
  status             String   @default("ACTIVE") // ACTIVE, INACTIVE, BROKEN
  score              Float    @default(0)
  
  alternatives       Resource[] @relation("ResourceAlternatives")
  alternativesOf     Resource[] @relation("ResourceAlternatives")
  
  affiliateDisclosure String?
  
  metadata           ResourceMetadata?
  collectionSteps    CollectionStep[]
  reports            Report[]
  alerts             Alert[]
  savedItems         SavedItem[]
  changelog          Changelog[]
  phaseResources     PhaseResource[]
  curatedCollectionItems CuratedCollectionItem[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ResourceMetadata {
  id          String   @id @default(cuid())
  resourceId  String   @unique
  resource    Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  
  banglaDescription String?
  customData        String? // JSON string or similar for extra metadata
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  
  resources   Resource[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tag {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  
  resources   Resource[] @relation("ResourceTags")
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Collection {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  outcome      String
  audience     String?
  constraints  String?
  difficulty   String?  // Beginner, Intermediate, Advanced
  timeToResult String?
  cost         String?
  
  curatorId    String?
  curator      Curator? @relation(fields: [curatorId], references: [id])
  
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  steps        CollectionStep[]
  alternatives String? // Text describing alternatives or a JSON structure
  actionPlan   String? // Text or markdown
  sources      String?
  
  lastVerified DateTime?
  changelog    Changelog[]
  savedItems   SavedItem[]
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CollectionStep {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  
  order        Int
  title        String
  description  String?
  
  resourceId   String?
  resource     Resource?  @relation(fields: [resourceId], references: [id])
  
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Report {
  id         String   @id @default(cuid())
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  
  type       String   // broken, outdated, payout_issue, price_change, country_change
  message    String?
  status     String   @default("OPEN") // OPEN, RESOLVED, DISMISSED
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Alert {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId  String?
  resource    Resource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  
  type        String
  threshold   String?
  triggeredAt DateTime?
  readAt      DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SavedItem {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  resourceId   String?
  resource     Resource?   @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  
  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  
  ideaId       String?
  idea         ImplementationIdea? @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  
  createdAt    DateTime    @default(now())
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  plan      String   // free, pro, premium
  status    String   @default("ACTIVE")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Changelog {
  id           String      @id @default(cuid())
  
  resourceId   String?
  resource     Resource?   @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  
  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  
  changes      String      // JSON describing what changed
  notes        String?
  
  createdAt    DateTime    @default(now())
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ImplementationIdea {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  outcome         String   @db.Text
  description     String?  @db.Text
  targetAudience  String?  @db.Text
  difficulty      String   // Beginner, Intermediate, Advanced
  estimatedTime   String
  estimatedCost   String
  category        String   // Creator Economy, SaaS & Startups, Freelancing & Business, Content & Media, Digital Products
  coverImage      String?
  featured        Boolean  @default(false)
  status          String   @default("PUBLISHED")
  keywords        String[] @default([])

  phases          ImplementationPhase[]
  actionPlans     IdeaActionPlan[]
  progress        UserIdeaProgress[]
  savedItems      SavedItem[]
  collectionItems CuratedCollectionItem[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ImplementationPhase {
  id                String   @id @default(cuid())
  ideaId            String
  idea              ImplementationIdea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  title             String
  description       String?  @db.Text
  outcome           String?  @db.Text
  position          Int
  estimatedDuration String?

  tasks             ImplementationTask[]
  resources         PhaseResource[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ImplementationTask {
  id          String   @id @default(cuid())
  phaseId     String
  phase       ImplementationPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  position    Int
  isOptional  Boolean  @default(false)

  userProgress UserTaskProgress[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PhaseResource {
  id           String   @id @default(cuid())
  phaseId      String
  phase        ImplementationPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  resourceId   String?
  resource     Resource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  name         String
  websiteUrl   String
  purpose      String?  @db.Text
  pricingModel String   // Free, Freemium, Paid
  hasFreeTier  Boolean  @default(false)
  isEssential  Boolean  @default(true)
  position     Int

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model IdeaActionPlan {
  id          String   @id @default(cuid())
  ideaId      String
  idea        ImplementationIdea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  stepNumber  Int
  title       String
  description String?  @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CuratedCollection {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @db.Text
  category    String?
  coverImage  String?
  featured    Boolean  @default(false)

  items       CuratedCollectionItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CuratedCollectionItem {
  id           String             @id @default(cuid())
  collectionId String
  collection   CuratedCollection  @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  ideaId       String?
  idea         ImplementationIdea? @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  resourceId   String?
  resource     Resource?          @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  position     Int

  createdAt    DateTime           @default(now())
}

model UserIdeaProgress {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  ideaId    String
  idea      ImplementationIdea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  startedAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([userId, ideaId])
}

model UserTaskProgress {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId      String
  task        ImplementationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  completed   Boolean            @default(false)
  completedAt DateTime?

  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([userId, taskId])
}

